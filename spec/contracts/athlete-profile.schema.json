{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coach:schema:athlete-profile:1",
  "title": "AthleteProfile",
  "description": "Athlete profile (FR-PRF-001 to FR-PRF-007). Version 1.1.0: age-predicted heart-rate zone models (ADR-028). Version 1.2.0: exercise aliases (P10). A tracked field that was never recorded is absent; a field recorded as UNKNOWN is {\"value\": null, \"provenance\": ...}. Owner spec: spec/functional/profile.spec.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "athleteId",
    "version",
    "identity",
    "physiology",
    "heartRate",
    "preferences",
    "devices",
    "experience"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "urn:coach:schema:common:1#/$defs/schemaVersion" },
    "athleteId": { "$ref": "urn:coach:schema:common:1#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 } },
          "unevaluatedProperties": false
        }
      }
    },
    "physiology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "birthDate": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "oneOf": [{ "$ref": "urn:coach:schema:common:1#/$defs/localDate" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        },
        "declaredAge": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["integer", "null"], "minimum": 18, "maximum": 100 } },
          "unevaluatedProperties": false
        },
        "heightCm": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["number", "null"], "minimum": 100, "maximum": 250 } },
          "unevaluatedProperties": false
        },
        "weightKg": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["number", "null"], "minimum": 30, "maximum": 250 } },
          "unevaluatedProperties": false
        }
      }
    },
    "heartRate": {
      "type": "object",
      "required": ["zoneModels"],
      "additionalProperties": false,
      "properties": {
        "restingHr": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["integer", "null"], "minimum": 25, "maximum": 120 } },
          "unevaluatedProperties": false
        },
        "maxHr": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["integer", "null"], "minimum": 100, "maximum": 230 } },
          "unevaluatedProperties": false
        },
        "zoneMethod": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": {
              "enum": [
                "PROVIDER",
                "PERCENT_MAX_HR",
                "HEART_RATE_RESERVE",
                "LACTATE_THRESHOLD_HR",
                "CUSTOM",
                "UNKNOWN",
                null
              ]
            }
          },
          "unevaluatedProperties": false
        },
        "zoneModels": { "type": "array", "items": { "$ref": "#/$defs/zoneModel" } }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "oneOf": [{ "$ref": "urn:coach:schema:common:1#/$defs/ianaTimezone" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        },
        "metricUnits": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["boolean", "null"] } },
          "unevaluatedProperties": false
        },
        "language": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "type": ["string", "null"], "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
          },
          "unevaluatedProperties": false
        }
      }
    },
    "devices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "garminModel": {
          "$ref": "#/$defs/tracked",
          "properties": { "value": { "type": ["string", "null"], "maxLength": 100 } },
          "unevaluatedProperties": false
        },
        "sensors": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": {
              "oneOf": [{ "type": "array", "items": { "$ref": "#/$defs/sensor" } }, { "type": "null" }]
            }
          },
          "unevaluatedProperties": false
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "running": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "oneOf": [{ "$ref": "#/$defs/runningExperience" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        },
        "cycling": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "oneOf": [{ "$ref": "#/$defs/cyclingExperience" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        },
        "swimming": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "oneOf": [{ "$ref": "#/$defs/swimmingExperience" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        },
        "strength": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "oneOf": [{ "$ref": "#/$defs/strengthExperience" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        },
        "tennis": {
          "$ref": "#/$defs/tracked",
          "properties": {
            "value": { "oneOf": [{ "$ref": "#/$defs/tennisExperience" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        }
      }
    },
    "resources": {
      "$ref": "#/$defs/tracked",
      "properties": {
        "value": { "oneOf": [{ "$ref": "#/$defs/resources" }, { "type": "null" }] }
      },
      "unevaluatedProperties": false
    },
    "health": {
      "$ref": "#/$defs/tracked",
      "properties": {
        "value": { "oneOf": [{ "$ref": "#/$defs/healthDeclaration" }, { "type": "null" }] }
      },
      "unevaluatedProperties": false
    },
    "exerciseAliases": {
      "description": "Version 1.2.0 (P10): the athlete's own names for catalogue exercises (strength spec 3); absent when there are none.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "exerciseId"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 100 },
          "exerciseId": { "$ref": "urn:coach:schema:workout:1#/$defs/exerciseId" }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source", "recordedAt", "provider", "metricId"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["ATHLETE_DECLARED", "PROVIDER", "DERIVED"] },
        "recordedAt": { "$ref": "urn:coach:schema:common:1#/$defs/utcInstant" },
        "provider": { "type": ["string", "null"], "pattern": "^[a-z0-9_]+$" },
        "metricId": {
          "oneOf": [{ "$ref": "urn:coach:schema:common:1#/$defs/metricId" }, { "type": "null" }]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "PROVIDER" } } },
          "then": { "properties": { "provider": { "type": "string" } } }
        },
        {
          "if": { "properties": { "source": { "const": "DERIVED" } } },
          "then": { "properties": { "metricId": { "type": "string" } } }
        }
      ]
    },
    "tracked": {
      "type": "object",
      "required": ["value", "provenance"],
      "properties": {
        "value": true,
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "nonNegativeOrUnknown": { "$ref": "urn:coach:schema:common:1#/$defs/nonNegativeOrUnknown" },
    "zoneModel": {
      "description": "Version 1.1.0: an AGE_PREDICTED model (a labelled estimate, ADR-028) holds boundariesPercentMaxHr instead of boundariesBpm.",
      "type": "object",
      "required": ["zoneModelId", "method", "source", "validFrom"],
      "additionalProperties": false,
      "properties": {
        "zoneModelId": { "$ref": "urn:coach:schema:common:1#/$defs/id" },
        "method": {
          "enum": ["PROVIDER", "PERCENT_MAX_HR", "HEART_RATE_RESERVE", "LACTATE_THRESHOLD_HR", "CUSTOM", "UNKNOWN"]
        },
        "source": { "enum": ["ATHLETE_DECLARED", "PROVIDER", "CALCULATED_FROM_MEASURED_ANCHORS", "AGE_PREDICTED"] },
        "boundariesBpm": {
          "description": "Strictly ascending; zone i spans [boundariesBpm[i], boundariesBpm[i+1]).",
          "type": "array",
          "minItems": 2,
          "maxItems": 11,
          "items": { "type": "integer", "minimum": 30, "maximum": 230 }
        },
        "boundariesPercentMaxHr": {
          "description": "AGE_PREDICTED only. Strictly ascending percentages of 220 minus the athlete's age on the training day; boundary bpm = ceil(p * maxHR / 100).",
          "type": "array",
          "minItems": 2,
          "maxItems": 11,
          "items": { "type": "integer", "minimum": 30, "maximum": 100 }
        },
        "validFrom": { "$ref": "urn:coach:schema:common:1#/$defs/localDate" }
      },
      "if": { "properties": { "source": { "const": "AGE_PREDICTED" } } },
      "then": {
        "required": ["boundariesPercentMaxHr"],
        "not": { "required": ["boundariesBpm"] },
        "properties": { "method": { "const": "PERCENT_MAX_HR" } }
      },
      "else": {
        "required": ["boundariesBpm"],
        "not": { "required": ["boundariesPercentMaxHr"] }
      }
    },
    "sensor": {
      "type": "object",
      "required": ["type", "model", "reliableForTraining"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["HR_STRAP", "CYCLING_POWER_METER", "CADENCE_SENSOR", "RUNNING_POD", "SMART_TRAINER", "OTHER"]
        },
        "model": { "type": ["string", "null"], "maxLength": 100 },
        "reliableForTraining": { "type": "boolean" }
      }
    },
    "raceResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["timeSeconds", "date", "source"],
          "additionalProperties": false,
          "properties": {
            "timeSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "date": { "$ref": "urn:coach:schema:common:1#/$defs/localDate" },
            "source": { "enum": ["ATHLETE_DECLARED", "PROVIDER"] }
          }
        },
        { "type": "null" }
      ]
    },
    "runningExperience": {
      "type": "object",
      "required": [
        "yearsExperience",
        "weeklyDistanceKm",
        "longestDistanceKm",
        "recent5k",
        "recent10k",
        "recentHalfMarathon",
        "recentMarathon"
      ],
      "additionalProperties": false,
      "properties": {
        "yearsExperience": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "weeklyDistanceKm": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "longestDistanceKm": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "recent5k": { "$ref": "#/$defs/raceResult" },
        "recent10k": { "$ref": "#/$defs/raceResult" },
        "recentHalfMarathon": { "$ref": "#/$defs/raceResult" },
        "recentMarathon": { "$ref": "#/$defs/raceResult" }
      }
    },
    "cyclingExperience": {
      "type": "object",
      "required": [
        "yearsExperience",
        "weeklyDistanceKm",
        "usualRideDistanceKm",
        "longestRideKm",
        "ftp",
        "powerMeterAvailable"
      ],
      "additionalProperties": false,
      "properties": {
        "yearsExperience": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "weeklyDistanceKm": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "usualRideDistanceKm": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "longestRideKm": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "ftp": {
          "oneOf": [
            {
              "type": "object",
              "required": ["watts", "date", "measured"],
              "additionalProperties": false,
              "properties": {
                "watts": { "type": "integer", "minimum": 50, "maximum": 600 },
                "date": { "$ref": "urn:coach:schema:common:1#/$defs/localDate" },
                "measured": { "type": "boolean" }
              }
            },
            { "type": "null" }
          ]
        },
        "powerMeterAvailable": { "type": ["boolean", "null"] }
      }
    },
    "swimmingExperience": {
      "type": "object",
      "required": [
        "yearsExperience",
        "weeklyDistanceM",
        "typicalPace100mSeconds",
        "longestDistanceM",
        "poolLengthM"
      ],
      "additionalProperties": false,
      "properties": {
        "yearsExperience": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "weeklyDistanceM": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "typicalPace100mSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "longestDistanceM": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "poolLengthM": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100 }
      }
    },
    "strengthExperience": {
      "type": "object",
      "required": [
        "yearsExperience",
        "sessionsPerWeek",
        "familiarExerciseIds",
        "approximateLoads",
        "rpeFamiliar",
        "rirFamiliar"
      ],
      "additionalProperties": false,
      "properties": {
        "yearsExperience": { "$ref": "#/$defs/nonNegativeOrUnknown" },
        "sessionsPerWeek": { "type": ["number", "null"], "minimum": 0, "maximum": 14 },
        "familiarExerciseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ex\\.[a-z0-9_]+$" }
        },
        "approximateLoads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["exerciseId", "loadKg", "reps", "date"],
            "additionalProperties": false,
            "properties": {
              "exerciseId": { "type": "string", "pattern": "^ex\\.[a-z0-9_]+$" },
              "loadKg": { "type": "number", "minimum": 0, "maximum": 500 },
              "reps": { "type": "integer", "minimum": 1, "maximum": 100 },
              "date": { "$ref": "urn:coach:schema:common:1#/$defs/localDate" }
            }
          }
        },
        "rpeFamiliar": { "type": ["boolean", "null"] },
        "rirFamiliar": { "type": ["boolean", "null"] }
      }
    },
    "tennisExperience": {
      "type": "object",
      "required": ["sessionsPerWeek", "typicalDurationMinutes", "typicalRpe", "profile"],
      "additionalProperties": false,
      "properties": {
        "sessionsPerWeek": { "type": ["number", "null"], "minimum": 0, "maximum": 14 },
        "typicalDurationMinutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 600 },
        "typicalRpe": { "$ref": "urn:coach:schema:common:1#/$defs/rpe" },
        "profile": { "enum": ["MATCH", "PRACTICE", "MIXED", null] }
      }
    },
    "resources": {
      "type": "object",
      "required": ["pool", "bicycle", "smartTrainer", "gym", "strengthEquipment", "tennisSchedule"],
      "additionalProperties": false,
      "properties": {
        "pool": {
          "oneOf": [
            {
              "type": "object",
              "required": ["available", "lengthM"],
              "additionalProperties": false,
              "properties": {
                "available": { "type": "boolean" },
                "lengthM": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 100 }
              }
            },
            { "type": "null" }
          ]
        },
        "bicycle": { "type": ["boolean", "null"] },
        "smartTrainer": { "type": ["boolean", "null"] },
        "gym": { "type": ["boolean", "null"] },
        "strengthEquipment": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "BARBELL",
              "DUMBBELLS",
              "KETTLEBELLS",
              "BANDS",
              "MACHINES",
              "PULL_UP_BAR",
              "BENCH",
              "BODYWEIGHT_ONLY",
              "OTHER"
            ]
          }
        },
        "tennisSchedule": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["weekday", "start", "durationMinutes", "sessionType"],
            "additionalProperties": false,
            "properties": {
              "weekday": { "$ref": "urn:coach:schema:common:1#/$defs/weekday" },
              "start": { "$ref": "urn:coach:schema:common:1#/$defs/localTime" },
              "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 600 },
              "sessionType": { "enum": ["MATCH", "PRACTICE", "UNKNOWN"] }
            }
          }
        }
      }
    },
    "healthDeclaration": {
      "description": "An empty constraints list is an explicit declaration of no constraints.",
      "type": "object",
      "required": ["declaredAt", "constraints"],
      "additionalProperties": false,
      "properties": {
        "declaredAt": { "$ref": "urn:coach:schema:common:1#/$defs/utcInstant" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/healthConstraint" } }
      }
    },
    "healthConstraint": {
      "type": "object",
      "required": [
        "constraintId",
        "description",
        "affectedRegions",
        "affectedSports",
        "restrictions",
        "declaredAt",
        "validUntil",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "constraintId": { "$ref": "urn:coach:schema:common:1#/$defs/id" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "affectedRegions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 50 }
        },
        "affectedSports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:coach:schema:common:1#/$defs/sport" }
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "maxRpe", "sport"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["NO_IMPACT", "NO_OVERHEAD", "NO_HEAVY_LOWER_BODY", "MAX_RPE", "NO_SPORT", "OTHER"]
              },
              "maxRpe": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
              "sport": {
                "oneOf": [{ "$ref": "urn:coach:schema:common:1#/$defs/sport" }, { "type": "null" }]
              }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "MAX_RPE" } } },
                "then": { "properties": { "maxRpe": { "type": "integer" } } }
              },
              {
                "if": { "properties": { "kind": { "const": "NO_SPORT" } } },
                "then": { "properties": { "sport": { "type": "string" } } }
              }
            ]
          }
        },
        "declaredAt": { "$ref": "urn:coach:schema:common:1#/$defs/utcInstant" },
        "validUntil": {
          "oneOf": [{ "$ref": "urn:coach:schema:common:1#/$defs/localDate" }, { "type": "null" }]
        },
        "source": { "enum": ["ATHLETE", "PROFESSIONAL_ADVICE_DECLARED"] }
      }
    }
  }
}
