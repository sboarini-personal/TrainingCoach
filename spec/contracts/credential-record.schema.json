{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coach:schema:credential-record:1",
  "title": "CredentialRecord",
  "description": "Metadata of a secret held in the OS secret store (SEC-SEC-001, SEC-SEC-004). Never contains the secret or a hash of it. Owner spec: spec/security/secrets.spec.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "credentialId",
    "athleteId",
    "version",
    "kind",
    "handle",
    "createdAt",
    "rotatedAt",
    "expiresOn"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "urn:coach:schema:common:1#/$defs/schemaVersion" },
    "credentialId": { "$ref": "urn:coach:schema:common:1#/$defs/id" },
    "athleteId": { "$ref": "urn:coach:schema:common:1#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["LOCAL_API_TOKEN", "GARMIN_PERSONAL_API_KEY", "LLM_API_KEY"] },
    "handle": {
      "type": "string",
      "pattern": "^(local_api_token|garmin_personal_api_key|llm_api_key)/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "createdAt": { "$ref": "urn:coach:schema:common:1#/$defs/utcInstant" },
    "rotatedAt": {
      "oneOf": [{ "$ref": "urn:coach:schema:common:1#/$defs/utcInstant" }, { "type": "null" }]
    },
    "expiresOn": {
      "oneOf": [{ "$ref": "urn:coach:schema:common:1#/$defs/localDate" }, { "type": "null" }]
    }
  }
}
