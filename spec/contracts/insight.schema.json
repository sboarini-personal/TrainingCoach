{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coach:schema:insight:1",
  "title": "PerformanceInsight",
  "description": "Structured insight (FR-INS-001). Observation, interpretation, hypothesis and recommendation are separate; the observation is written in code from derived values, the other three by the AI coach (null until P13). There is no causal relationship value (FR-INS-003). Owner spec: spec/functional/insights.spec.md.",
  "type": "object",
  "required": [
    "schemaVersion",
    "insightId",
    "athleteId",
    "kind",
    "observation",
    "interpretation",
    "hypothesis",
    "recommendation",
    "relationship",
    "evidence",
    "confidence",
    "uncertaintyReasons",
    "generatedAt",
    "calculationVersions",
    "agentVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "$ref": "urn:coach:schema:common:1#/$defs/schemaVersion" },
    "insightId": { "$ref": "urn:coach:schema:common:1#/$defs/id" },
    "athleteId": { "$ref": "urn:coach:schema:common:1#/$defs/id" },
    "version": {
      "description": "Storage version (P11); insights are immutable, so it is 1. Absent before it existed.",
      "type": "integer",
      "minimum": 1
    },
    "kind": { "type": "string", "pattern": "^PATTERN\\.[A-Z_]+$" },
    "period": {
      "description": "The days the observation covers (P11). Absent in insights from before it existed.",
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "urn:coach:schema:common:1#/$defs/localDate" },
        "end": { "$ref": "urn:coach:schema:common:1#/$defs/localDate" }
      }
    },
    "rulesVersion": {
      "description": "Version of the pattern rules that detected it (P11).",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "observation": {
      "description": "What the data shows; produced from derived metrics in code.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "interpretation": { "type": ["string", "null"], "maxLength": 1000 },
    "hypothesis": {
      "description": "Explicitly tentative explanation.",
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "recommendation": {
      "description": "Proposed training action; subject to the policy engine before any effect.",
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "relationship": {
      "description": "NONE, or ASSOCIATION between variables. Causation is never asserted.",
      "enum": ["NONE", "ASSOCIATION"]
    },
    "association": {
      "type": "object",
      "required": ["variables", "sampleSize", "windowDays"],
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "urn:coach:schema:common:1#/$defs/metricId" }
        },
        "sampleSize": { "type": "integer", "minimum": 1 },
        "windowDays": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:coach:schema:common:1#/$defs/evidenceRef" }
    },
    "confidence": { "$ref": "urn:coach:schema:common:1#/$defs/confidence" },
    "uncertaintyReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:coach:schema:common:1#/$defs/uncertaintyReason" }
    },
    "generatedAt": { "$ref": "urn:coach:schema:common:1#/$defs/utcInstant" },
    "calculationVersions": {
      "description": "metricId to calculationVersion used for the evidence.",
      "type": "object",
      "propertyNames": { "$ref": "urn:coach:schema:common:1#/$defs/metricId" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
    },
    "agentVersion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["promptVersion", "modelId"],
          "additionalProperties": false,
          "properties": {
            "promptVersion": { "type": "string", "maxLength": 20 },
            "modelId": { "type": ["string", "null"], "maxLength": 100 }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "if": { "properties": { "relationship": { "const": "ASSOCIATION" } } },
  "then": { "required": ["association"] }
}
